{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://provoware.local/schemas/questions.schema.json",
  "title": "PROVOWARE Fragenkatalog",
  "type": "object",
  "required": [
    "catalogVersion",
    "phases",
    "questions"
  ],
  "additionalProperties": false,
  "properties": {
    "catalogVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "phases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "questions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "phaseId",
          "type",
          "required",
          "title",
          "shortHelp",
          "why",
          "example",
          "pro",
          "contra",
          "alternative",
          "recommendation",
          "details",
          "recommendedValue",
          "options"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]*\\.[a-z0-9._-]+$"
          },
          "phaseId": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "const": "single"
          },
          "required": {
            "type": "boolean"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "shortHelp": {
            "type": "string",
            "minLength": 1
          },
          "why": {
            "type": "string",
            "minLength": 1
          },
          "example": {
            "type": "string",
            "minLength": 1
          },
          "pro": {
            "type": "string",
            "minLength": 1
          },
          "contra": {
            "type": "string",
            "minLength": 1
          },
          "alternative": {
            "type": "string",
            "minLength": 1
          },
          "recommendation": {
            "type": "string",
            "minLength": 1
          },
          "details": {
            "type": "string",
            "minLength": 1
          },
          "recommendedValue": {
            "type": "string",
            "minLength": 1
          },
          "options": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "required": [
                "value",
                "label",
                "description"
              ],
              "additionalProperties": false,
              "properties": {
                "value": {
                  "type": "string",
                  "minLength": 1
                },
                "label": {
                  "type": "string",
                  "minLength": 1
                },
                "description": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    }
  }
}
