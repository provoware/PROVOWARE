{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://provoware.local/schemas/project.schema.json",
  "title": "PROVOWARE Projektstand",
  "type": "object",
  "required": [
    "schemaVersion",
    "projectId",
    "name",
    "answers"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "projectId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "answers": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "string",
          "number",
          "boolean",
          "array",
          "null"
        ]
      }
    },
    "currentQuestionId": {
      "type": [
        "string",
        "null"
      ]
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}
