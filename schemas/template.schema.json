{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://provoware.local/schemas/template.schema.json",
  "title": "PROVOWARE Projektvorlage",
  "type": "object",
  "required": [
    "id",
    "title",
    "answerDefaults"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^template\\.[a-z0-9._-]+$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "answerDefaults": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "string",
          "number",
          "boolean",
          "array",
          "null"
        ]
      }
    }
  }
}
