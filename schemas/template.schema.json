{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://provoware.local/schemas/template.schema.json",
  "title": "PROVOWARE Projektvorlagen-Modul",
  "type": "object",
  "required": [
    "id",
    "title",
    "description",
    "category",
    "modulePath",
    "profileCount"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^template\\.[a-z0-9._-]+$"
    },
    "title": {
      "type": "string",
      "minLength": 3,
      "maxLength": 80
    },
    "description": {
      "type": "string",
      "minLength": 10,
      "maxLength": 400
    },
    "category": {
      "type": "string",
      "minLength": 3,
      "maxLength": 80
    },
    "modulePath": {
      "type": "string",
      "pattern": "^data/template-profiles/[a-z0-9._-]+\\.js$"
    },
    "profileCount": {
      "type": "integer",
      "minimum": 1,
      "maximum": 50
    }
  }
}
