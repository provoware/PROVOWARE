{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://provoware.local/schemas/project-package.schema.json",
  "title": "PROVOWARE-Projektpaket",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "packageSchemaVersion",
    "applicationVersion",
    "exportedAt",
    "source",
    "project",
    "checksum"
  ],
  "properties": {
    "packageSchemaVersion": {
      "const": "1.0.0"
    },
    "applicationVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32
    },
    "exportedAt": {
      "type": "string",
      "format": "date-time"
    },
    "checksum": {
      "type": "string",
      "pattern": "^[a-f0-9]{8}$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "projectId",
        "projectName",
        "revision",
        "lifecycle",
        "projectSchemaVersion",
        "questionCatalogVersion"
      ],
      "properties": {
        "projectId": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$"
        },
        "projectName": {
          "type": "string",
          "minLength": 3,
          "maxLength": 80
        },
        "revision": {
          "type": "integer",
          "minimum": 0
        },
        "lifecycle": {
          "enum": ["active", "archive", "trash"]
        },
        "projectSchemaVersion": {
          "enum": ["1.0.0", "1.1.0", "1.2.0"]
        },
        "questionCatalogVersion": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "project": {
      "type": "object",
      "required": ["schemaVersion", "projectId", "answers"],
      "properties": {
        "schemaVersion": {
          "enum": ["1.0.0", "1.1.0", "1.2.0"]
        },
        "projectId": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$"
        },
        "name": {
          "type": "string",
          "minLength": 3,
          "maxLength": 80
        },
        "answers": {
          "type": "object"
        },
        "currentQuestionId": {
          "type": ["string", "null"]
        },
        "theme": {
          "enum": ["dark", "light"]
        },
        "questionCatalogVersion": {
          "type": "string"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "lastValidatedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
